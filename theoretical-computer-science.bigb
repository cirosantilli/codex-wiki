| 0
| $1,2$
| 2
| 0
| 3
| 001
| 0
| $1,2$
| 2
| 1
| 3
| 010
| 0
| $1,2,3$
| 3
| 1
| 3
| 011
| 1
| $1,2,3$
| 3
| 0
| 3
| 100
