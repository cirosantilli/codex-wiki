{parent=Artery}

= Carotid sinus
{parent=Internal carotid artery}

= Carotid body
{parent=Carotid sinus}

= Ophthalmic artery
{parent=Artery}

= Posterior ethmoidal artery
{parent=Ophthalmic artery}

= Anterior ethmoidal artery
{parent=Ophthalmic artery}

