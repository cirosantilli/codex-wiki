\boxed{A=\begin{pmatrix}1&2\alpha&\beta\\1&-1&3\\-3&3&-3\alpha\end{pmatrix},\qquad
\mathbf x=\begin{pmatrix}x\\y\\z\end{pmatrix},\qquad
\mathbf b=\begin{pmatrix}1\\-1\\3\end{pmatrix},\qquad A\mathbf x=\mathbf b}.
