$$
\begin{array}{c}
E\\[1mm]
\mathbb Q(\sqrt2,\sqrt3)\quad
\mathbb Q(\alpha)\quad\mathbb Q(\beta)\quad
\mathbb Q(\alpha+\beta)\quad\mathbb Q(\alpha-\beta)\\[1mm]
\mathbb Q(\sqrt2)\qquad
\mathbb Q(\sqrt3)\qquad
\mathbb Q(\sqrt6)\\[1mm]
\mathbb Q.
\end{array}
